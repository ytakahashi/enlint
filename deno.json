{
  "name": "@ytakahashi/enlint",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./cli/main.ts"
  },
  "imports": {
    "#core/": "./core/",
    "#infra/": "./infra/",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "ai": "npm:ai@7.0.107"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "**/_fixtures/",
      "core/testing/",
      "desktop/",
      "tests/",
      "tools/"
    ]
  },
  "lint": {
    "plugins": [
      "./tools/lint_plugin.ts"
    ]
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check .",
    "lint": "deno lint",
    "test": "deno test --allow-read --ignore=tests/",
    "test:golden": "deno test --allow-read --allow-env=AI_GATEWAY_API_KEY,ENLINT_GOLDEN_REPEATS,ENLINT_GOLDEN_CONCURRENCY,ENLINT_GOLDEN_TIMEOUT_MS,ENLINT_GOLDEN_INTERVAL_MS --allow-net --allow-sys=hostname tests/golden_test.ts",
    "golden:report": "deno run --allow-read --allow-write=.enlint --allow-env=AI_GATEWAY_API_KEY,ENLINT_GOLDEN_REPEATS,ENLINT_GOLDEN_CONCURRENCY,ENLINT_GOLDEN_TIMEOUT_MS,ENLINT_GOLDEN_INTERVAL_MS --allow-net --allow-sys=hostname tools/golden/run.ts",
    "test:live": "deno test --allow-all --permit-no-files tests/"
  }
}
